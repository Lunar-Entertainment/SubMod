<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CallOfTheAbyss</AssemblyName>
    <RootNamespace>CallOfTheAbyss</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="Subnautica.GameLibs" Version="82304.0.0-r.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2020.3.48" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Nautilus">
      <HintPath>lib\Nautilus.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
